{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tuktuk-dev",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-20",
  "compatibility_flags": ["nodejs_compat"],

  // The fake-WhatsApp harness is bundled into the Worker as text, not shipped
  // as a static asset. Assets are served before the Worker runs, so an asset
  // could never be gated on DEV_MODE — keeping the page out of ./public is the
  // only way its gate is unconditional.
  "rules": [{ "type": "Text", "globs": ["**/harness.html"] }],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tuktuk",
      // Local dev does not care about this id. Replace it after running:
      //   wrangler d1 create tuktuk
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // DEV_MODE routes outbound messages to the fake-WhatsApp harness and opens
    // the /dev/* routes, which inject unauthenticated inbound messages.
    //
    // It defaults to "false" here on purpose: the safe value has to be the one
    // you get by accident. `npm run dev` turns it on with `--var DEV_MODE:true`,
    // which is a dev-server-only override, so no deploy can ever ship it on.
    "DEV_MODE": "false",
    "WHATSAPP_PHONE_NUMBER_ID": "",
    "WHATSAPP_API_VERSION": "v21.0"
  },

  // Secrets (set with `wrangler secret put <NAME> --env <env>`):
  //   WHATSAPP_TOKEN          non-expiring System User token
  //   WHATSAPP_APP_SECRET     for webhook signature verification
  //   WHATSAPP_VERIFY_TOKEN   any random string; must match the Meta dashboard

  "triggers": {
    "crons": ["* * * * *"]
  },

  "observability": {
    "enabled": true
  },

  "env": {
    "staging": {
      "name": "tuktuk-staging",
      "vars": {
        "DEV_MODE": "false",
        "WHATSAPP_PHONE_NUMBER_ID": "REPLACE_WITH_TEST_NUMBER_ID",
        "WHATSAPP_API_VERSION": "v21.0"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tuktuk-staging",
          "database_id": "REPLACE_AFTER_D1_CREATE",
          "migrations_dir": "migrations"
        }
      ],
      "assets": { "directory": "./public", "binding": "ASSETS" },
      "triggers": { "crons": ["* * * * *"] }
    },
    "production": {
      "name": "tuktuk-prod",
      "vars": {
        "DEV_MODE": "false",
        "WHATSAPP_PHONE_NUMBER_ID": "REPLACE_WITH_REAL_NUMBER_ID",
        "WHATSAPP_API_VERSION": "v21.0"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tuktuk-prod",
          "database_id": "REPLACE_AFTER_D1_CREATE",
          "migrations_dir": "migrations"
        }
      ],
      "assets": { "directory": "./public", "binding": "ASSETS" },
      "triggers": { "crons": ["* * * * *"] }
    }
  }
}
